{
  "realm": "demo",
  "displayName": "Demo (local development)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "basic",
      "description": "Adds the sub claim. Declared here because a realm file that lists clientScopes replaces Keycloak's built-in scopes.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "customers:read",
      "description": "Read customers. Spring authority: SCOPE_customers:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "customers:write",
      "description": "Create and change customers. Spring authority: SCOPE_customers:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "ops:read",
      "description": "Read protected actuator endpoints. Spring authority: SCOPE_ops:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "accounts:read",
      "description": "Read accounts. Spring authority: SCOPE_accounts:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "accounts:write",
      "description": "Open and close accounts, deposit, withdraw. Spring authority: SCOPE_accounts:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "defaultDefaultClientScopes": [
    "basic"
  ],
  "defaultOptionalClientScopes": [],
  "clients": [
    {
      "clientId": "demo-service",
      "name": "Demo service (customers + accounts, read + write)",
      "description": "Machine client. client_credentials only. Request ops:read explicitly when needed.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${DEMO_SERVICE_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "customers:read",
        "customers:write",
        "accounts:read",
        "accounts:write"
      ],
      "optionalClientScopes": [
        "ops:read"
      ],
      "protocolMappers": [
        {
          "name": "audience-demo-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "demo-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "demo-readonly",
      "name": "Demo read-only client",
      "description": "Machine client with customers:read and accounts:read only. Use it to check that writes return 403.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${DEMO_READONLY_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "customers:read",
        "accounts:read"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-demo-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "demo-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-demo-service",
      "enabled": true,
      "serviceAccountClientId": "demo-service"
    },
    {
      "username": "service-account-demo-readonly",
      "enabled": true,
      "serviceAccountClientId": "demo-readonly"
    }
  ]
}
