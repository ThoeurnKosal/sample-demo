# ---------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY. Copy to .env:   cp .env.example .env
# .env is gitignored. Real environments never use this file:
# the database passwords live in Vault, the AppRole secret_id comes from CI.
# ---------------------------------------------------------------
APP_NAME=demo
DB_NAME=mydb

POSTGRES_IMAGE_TAG=17
VAULT_IMAGE_TAG=2.1.0

# Postgres superuser: container bootstrap only, the app never uses it
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-super-pw

# Schema owner: Flyway migrations (DDL)
DB_OWNER_USER=demo_owner
DB_OWNER_PASSWORD=local-owner-pw

# Application user: reads and writes data only (DML)
DB_APP_USER=demo_app
DB_APP_PASSWORD=local-app-pw

# Vault dev mode
VAULT_DEV_ROOT_TOKEN=local-root-token
VAULT_APP_ROLE_ID=demo-local-role-id
VAULT_APP_SECRET_ID=demo-local-secret-id


# Keycloak dev mode (JWT issuer). Realm "demo" is imported from docker/keycloak/realm-demo.json
KEYCLOAK_IMAGE_TAG=26.7.1
KEYCLOAK_HOST_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=local-admin-pw
# Client secrets for the two machine clients of realm "demo"
DEMO_SERVICE_CLIENT_SECRET=local-demo-service-secret
DEMO_READONLY_CLIENT_SECRET=local-demo-readonly-secret


# Redis (cache only). The app user and password are also written to Vault by vault-init.
REDIS_IMAGE_TAG=8.8
REDIS_HOST_PORT=6379
REDIS_MAX_MEMORY=128mb
REDIS_APP_USER=demo
REDIS_APP_PASSWORD=local-redis-pw
